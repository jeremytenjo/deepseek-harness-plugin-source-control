{
  "name": "@local/dsh-commit-message",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Source control for DeepSeek Harness: T3-style diffs, commit messages, GitHub repository creation, commit and push.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jeremytenjo/deepseek-harness-plugin-source-control.git"
  },
  "homepage": "https://github.com/jeremytenjo/deepseek-harness-plugin-source-control#readme",
  "bugs": {
    "url": "https://github.com/jeremytenjo/deepseek-harness-plugin-source-control/issues"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "client.diff.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-sidebar-right"
      ]
    }
  },
  "devDependencies": {
    "@pierre/diffs": "1.5.2",
    "@radix-ui/react-context-menu": "2.2.4",
    "@radix-ui/react-dialog": "1.1.4",
    "@radix-ui/react-slot": "1.1.1",
    "@types/node": "22.10.5",
    "@types/react": "18.3.18",
    "@types/react-dom": "18.3.5",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "esbuild": "0.25.10",
    "lucide-react": "0.468.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-zoom-pan-pinch": "^4.2.0",
    "tailwind-merge": "2.6.0",
    "tailwindcss": "3.4.17",
    "typescript": "5.7.3"
  },
  "scripts": {
    "build": "node scripts/build-client.mjs",
    "typecheck": "tsc --noEmit"
  }
}
